{
  "name": "@sahaj/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sahaj API — Fastify backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "seed:knowledge": "tsx src/scripts/seed-knowledge.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "eval": "tsx src/scripts/eval.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@sahaj/shared": "workspace:*",
    "fastify": "^4.28.1",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^2.0.0",
    "groq-sdk": "^0.7.0",
    "lru-cache": "^11.0.1",
    "minisearch": "^7.1.0",
    "mongodb": "^6.9.0",
    "p-queue": "^8.0.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
