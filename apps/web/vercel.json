{
  "buildCommand": "pnpm --filter @sahaj/shared build && pnpm --filter @sahaj/web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sahaj-api.railway.app/api/:path*"
    }
  ]
}
