# ============================================================
#  SAHAJ — Environment Variables Reference
#  Copy this file to .env and fill in real values.
#  .env is git-ignored. .env.example is committed (no secrets).
# ============================================================

# ──────────────────────────────────────────────────────────────
# GLOBAL DEMO MODE
# ──────────────────────────────────────────────────────────────
# When DEMO_MODE=mock, ALL external services use mock adapters.
# No API keys needed. Anyone can pnpm dev and see the full demo.
# Set individual adapters to "live" below to override per-service.
DEMO_MODE=mock

# ──────────────────────────────────────────────────────────────
# RUNTIME
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info                         # trace | debug | info | warn | error

# ──────────────────────────────────────────────────────────────
# API SERVER
# ──────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# Allowed CORS origins (comma-separated). Add your Vercel URL in prod.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limits
RATE_LIMIT_MAX=100                     # requests per window per IP
RATE_LIMIT_WINDOW_MS=60000            # 1 minute

# Session (httpOnly JWT cookie)
SESSION_SECRET=change-this-to-a-long-random-string-in-production
SESSION_MAX_AGE_SECONDS=86400          # 24 hours
GUEST_SESSION_TTL_SECONDS=2592000     # 30 days

# ──────────────────────────────────────────────────────────────
# WEB / NEXT.JS
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Sahaj
NEXT_PUBLIC_DEMO_BADGE=true            # Shows "Demo data" badge always

# ──────────────────────────────────────────────────────────────
# DATABASE — MONGODB
# ──────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/sahaj
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/sahaj
MONGODB_URI=mongodb://localhost:27017/sahaj
MONGODB_DB_NAME=sahaj
MONGODB_TEST_DB_NAME=sahaj_test

# ──────────────────────────────────────────────────────────────
# CACHE — REDIS (optional)
# ──────────────────────────────────────────────────────────────
# If unset, uses in-process LRU cache. Set for production.
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ──────────────────────────────────────────────────────────────
# LLM ADAPTER
# Mode: mock | groq | openai-compatible
# ──────────────────────────────────────────────────────────────
LLM_ADAPTER=mock

# Groq (primary live adapter)
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=qwen-qwq-32b-preview
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.2

# OpenAI-compatible fallback (set LLM_ADAPTER=openai-compatible)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# LLM timeouts (ms)
LLM_FIRST_TOKEN_TIMEOUT_MS=4000
LLM_TOTAL_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────────
# KNOWLEDGE STORE — COGNEE
# Mode: mock | local-bm25 | cognee-live
# ──────────────────────────────────────────────────────────────
KNOWLEDGE_ADAPTER=mock

# Cognee Cloud (live mode)
# COGNEE_API_KEY=your-cognee-api-key-here
COGNEE_BASE_URL=https://api.cognee.ai
COGNEE_SEARCH_MODE=graph_completion    # graph_completion | rag | summaries
COGNEE_TOP_K=6
COGNEE_RETRIEVAL_TIMEOUT_MS=1500

# Corpus version for cache-key invalidation (bump when re-seeding)
KNOWLEDGE_CORPUS_VERSION=1

# ──────────────────────────────────────────────────────────────
# SARVAM AI
# Mode: mock | live
# ──────────────────────────────────────────────────────────────
SARVAM_ADAPTER=mock

# SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-2b
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_DOCUMENT_AI_ENDPOINT=/v1/document-intelligence
SARVAM_TIMEOUT_MS=6000

# ──────────────────────────────────────────────────────────────
# STORAGE ADAPTER
# Mode: local | s3
# ──────────────────────────────────────────────────────────────
STORAGE_ADAPTER=local
STORAGE_LOCAL_PATH=./uploads
UPLOAD_MAX_SIZE_BYTES=10485760         # 10 MB

# S3-compatible (Cloudflare R2, AWS S3, MinIO)
# STORAGE_S3_BUCKET=sahaj-uploads
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=xxxx
# STORAGE_S3_SECRET_ACCESS_KEY=xxxx

# ──────────────────────────────────────────────────────────────
# n8n AUTOMATION (optional, async only — never in chat critical path)
# ──────────────────────────────────────────────────────────────
N8N_ADAPTER=mock
# N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook
# N8N_WEBHOOK_SECRET=your-hmac-secret
N8N_RETRY_MAX=3
N8N_RETRY_DELAY_MS=5000

# ──────────────────────────────────────────────────────────────
# PAYTM CONNECTOR
# Mode: mock-paytm | paytm-sandbox-stub (stub throws NotConfigured)
# ──────────────────────────────────────────────────────────────
PAYTM_CONNECTOR=mock-paytm
# Note: No real Paytm keys committed. Sandbox stub is available
# but requires hackathon organiser credentials.

# ──────────────────────────────────────────────────────────────
# ESCALATION
# ──────────────────────────────────────────────────────────────
ESCALATION_EMAIL=escalation@demo.sahaj.local   # placeholder for demo
ESCALATION_WEBHOOK_ENABLED=false

# ──────────────────────────────────────────────────────────────
# TELEMETRY / OBSERVABILITY (all optional)
# ──────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=sahaj-api

# ──────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ──────────────────────────────────────────────────────────────
FEATURE_VOICE=false                    # Enable voice (Sarvam STT/TTS)
FEATURE_3D_THREAD=true                 # Enable 3D JourneyThread canvas
FEATURE_DEV_DRILL=true                 # ?dev=1 failure drill overlay
FEATURE_KNOWLEDGE_TRACE=true           # "Behind the scenes" drawer
