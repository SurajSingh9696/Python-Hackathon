{
  "name": "sahaj",
  "version": "0.1.0",
  "private": true,
  "description": "Sahaj — AI-powered financial journey companion (NPM Tigers · Paytm Hackathon Track 2)",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @sahaj/shared build && pnpm --parallel --filter ./apps/* build",
    "test": "pnpm --recursive run test",
    "test:e2e": "pnpm --filter @sahaj/web test:e2e",
    "lint": "pnpm --recursive run lint",
    "type-check": "pnpm --recursive run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml}\" --ignore-path .gitignore",
    "seed:knowledge": "pnpm --filter @sahaj/api seed:knowledge",
    "seed:demo": "pnpm --filter @sahaj/api seed:demo",
    "eval": "pnpm --filter @sahaj/api eval",
    "secret-scan": "bash scripts/secret-scan.sh",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
